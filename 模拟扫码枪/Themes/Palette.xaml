<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==========================================================
         调色板 / Palette
         浅色主题，色相以中性冷灰为底，品牌蓝为强调色。
         ========================================================== -->

    <!-- 基础中性色 -->
    <Color x:Key="AppBackgroundColor">#F2F4F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#F7F9FC</Color>
    <Color x:Key="SurfaceSunkenColor">#EDF1F7</Color>
    <Color x:Key="BorderSubtleColor">#E6EAF0</Color>
    <Color x:Key="BorderStrongColor">#CBD3DF</Color>

    <!-- 文本色 -->
    <Color x:Key="TextPrimaryColor">#16202E</Color>
    <Color x:Key="TextSecondaryColor">#4B5768</Color>
    <Color x:Key="TextMutedColor">#8A94A6</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- 强调色 -->
    <Color x:Key="AccentColor">#2F6FED</Color>
    <Color x:Key="AccentHoverColor">#2559CE</Color>
    <Color x:Key="AccentPressedColor">#1E4AA8</Color>
    <Color x:Key="AccentSubtleColor">#E8F0FE</Color>
    <Color x:Key="AccentBorderColor">#B9D0FB</Color>

    <!-- 语义色 -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessSubtleColor">#E6F6EC</Color>
    <Color x:Key="SuccessBorderColor">#A8E0BE</Color>
    <Color x:Key="WarningColor">#C2760A</Color>
    <Color x:Key="WarningSubtleColor">#FDF3E3</Color>
    <Color x:Key="WarningBorderColor">#F0D2A0</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSubtleColor">#FDECEC</Color>
    <Color x:Key="DangerBorderColor">#F6B9B9</Color>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}"/>

    <!-- 语义别名（供业务代码使用） -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource DangerColor}"/>

    <!-- 标题栏（Mica 之上的一层半透明玻璃） -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#1A16202E"/>

    <!-- 尺寸 -->
    <sys:Double x:Key="FontSizeCaption">11.5</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>

    <!-- 字体 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
